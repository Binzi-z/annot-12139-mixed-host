{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "taint_sa",
          "version": "1.0.0",
          "informationUri": "https://example.invalid/taint_sa",
          "rules": [
            {
              "id": "command_injection",
              "name": "PythonCommandInjection",
              "shortDescription": {
                "text": "Python 命令注入（污点到 sink 可达）"
              },
              "fullDescription": {
                "text": "基于自建 CFG 与污点状态的跨过程分析：Flask/Celery/环境变量 源经拼接、参数列表误用、shell 包装、模板渲染、闭包/实例属性 传播到达 subprocess/os.system/os.popen 等执行点。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "messageStrings": {
                "concat_shell": {
                  "text": "外部输入经字符串拼接进入 shell=True 的命令执行"
                },
                "arglist_misuse": {
                  "text": "外部输入成为 argv[0] 或 /bin/sh -c 的命令字符串"
                },
                "shell_wrapper": {
                  "text": "外部输入经配置登记的 shell 包装函数进入 shell"
                },
                "template_rendered": {
                  "text": "外部输入经模板渲染生成命令字符串后被执行"
                },
                "closure": {
                  "text": "外部输入被闭包捕获后到达命令执行点"
                },
                "class_attr": {
                  "text": "外部输入存入实例属性，稍后被 shell 执行"
                }
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "command_injection",
          "level": "error",
          "message": {
            "text": "[command_injection/concat_shell] 污点源 flask.args 经 request.args.get(...) -> concat 到达命令执行点"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "services/admin/console.py"
                },
                "region": {
                  "startLine": 21,
                  "snippet": {
                    "text": "subprocess.run(shell=True)"
                  }
                }
              }
            }
          ],
          "properties": {
            "variant": "concat_shell",
            "sources": [
              "flask.args"
            ],
            "taint_path": [
              "request.args.get(...)",
              "concat"
            ],
            "security-severity": "8.8",
            "cwe": "CWE-78"
          }
        },
